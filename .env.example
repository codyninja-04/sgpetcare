NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=
# Optional, defaults to claude-sonnet-5-5
CLAUDE_MODEL=

RESEND_API_KEY=
# Sender for reminder emails, must be on a domain verified in Resend
REMINDER_FROM_EMAIL=SGPetCare <reminders@sgpetcare.app>

# Web push. Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@sgpetcare.app

CRON_SECRET=
NEXT_PUBLIC_APP_URL=https://sgpetcare.app

# Free plan limits are shown in the UI but only enforced when this is true
ENFORCE_PRO=false
